<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="FenetreDialogSeries"
        Title="Détail par série" Width="540" SizeToContent="Height" MinWidth="480" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtTitreDialogSeries" Text="Détail par série" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="Pré-rempli avec les valeurs actuelles de l'exercice : modifie seulement les séries qui doivent être différentes." FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Répétitions" FontWeight="SemiBold" FontSize="12" Margin="0,0,6,2" />
            <TextBlock Grid.Column="2" Text="Charge" FontWeight="SemiBold" FontSize="12" Margin="0,0,6,2" />
            <TextBlock Grid.Column="3" Text="Récup (s)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2" />
        </Grid>

        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PanelSeriesLignes" />
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnDialogAjouterSerie" Content="+ Ajouter une série" />
            <Button x:Name="BtnDialogRetirerSerie" Content="- Retirer la dernière" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button x:Name="BtnDialogAnnuler" Content="Annuler" />
            <Button x:Name="BtnDialogValider" Content="Valider" Background="#27AE60" Foreground="White" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
