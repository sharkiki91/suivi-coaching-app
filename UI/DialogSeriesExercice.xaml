<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="FenetreDialogSeries"
        Title="Détail par série" Width="480" SizeToContent="Height" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="AlternatingRowBackground" Value="#F5F7FA" />
            <Setter Property="MaxHeight" Value="220" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtTitreDialogSeries" Text="Détail par série" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="Laisse un champ vide pour reprendre la valeur globale de l'exercice sur cette série." FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12" />

        <DataGrid x:Name="GridDialogSeries" Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Série" Binding="{Binding numero_serie}" Width="60" />
                <DataGridTextColumn Header="Répétitions" Binding="{Binding repetitions}" Width="*" />
                <DataGridTextColumn Header="Charge" Binding="{Binding charge}" Width="*" />
                <DataGridTextColumn Header="Récup (s)" Binding="{Binding recuperation_s}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Label Content="Ajouter / modifier la série sélectionnée" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtDialogSerieRepetitions" Grid.Column="0" />
            <TextBox x:Name="TxtDialogSerieCharge" Grid.Column="1" />
            <TextBox x:Name="TxtDialogSerieRecup" Grid.Column="2" Margin="0" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnDialogNouvelleSerie" Content="Nouvelle série" />
            <Button x:Name="BtnDialogSerieAjouter" Content="Ajouter / Enregistrer" Background="#27AE60" Foreground="White" />
            <Button x:Name="BtnDialogSerieSupprimer" Content="Supprimer" Background="#C0392B" Foreground="White" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button x:Name="BtnDialogFermer" Content="Fermer" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
