<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="FenetreDialogColonnesTracking"
        Title="Options de la feuille à envoyer" Width="560" SizeToContent="Height" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,18,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="100" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Options de la feuille à envoyer" FontSize="18" FontWeight="Bold" Margin="0,0,0,6" />
        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                   Text="Coche les colonnes à mettre dans l'onglet TRACKING envoyé au client. Ton choix est gardé pour les prochains exports." />
        <StackPanel x:Name="PanelDialogColonnes" />
        <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
            <StackPanel>
                <CheckBox x:Name="ChkDialogBilan" Content="Case BILAN de la semaine (une case par semaine, avec le lien du formulaire)" FontWeight="SemiBold" />
                <TextBlock Text="Lien du formulaire de bilan :" Margin="0,6,0,0" />
                <TextBox x:Name="TxtDialogLienBilan" />
            </StackPanel>
        </Border>
        <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Nombre de semaines" FontWeight="SemiBold" />
                <StackPanel x:Name="PanelDialogSemainesSeance" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Tableau des séances (blocs SEMAINE) :" Width="300" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtDialogSemainesSeance" Width="60" HorizontalContentAlignment="Center" ToolTip="De 1 à 52 semaines" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Tracking quotidien (onglet TRACKING) :" Width="300" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtDialogSemainesTracking" Width="60" HorizontalContentAlignment="Center" ToolTip="De 1 à 104 semaines" />
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button x:Name="BtnDialogAnnuler" Content="Annuler" />
            <Button x:Name="BtnDialogValider" Content="Exporter" Background="#27AE60" Foreground="White" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
