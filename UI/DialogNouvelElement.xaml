<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="FenetreDialog"
        Title="Nouvel élément" Width="440" SizeToContent="Height" MinWidth="380" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="100" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtTitreDialog" Text="Nouvel élément" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
        <Label Content="Nom *" />
        <TextBox x:Name="TxtDialogNom" />
        <Label Content="Date de début" />
        <DatePicker x:Name="DateDialogDebut" />
        <Label Content="Notes" />
        <TextBox x:Name="TxtDialogNotes" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button x:Name="BtnDialogAnnuler" Content="Annuler" />
            <Button x:Name="BtnDialogValider" Content="Créer" Background="#27AE60" Foreground="White" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
