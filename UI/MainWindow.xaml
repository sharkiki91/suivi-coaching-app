                        </Grid.RowDefinitions>

                        <DataGrid x:Name="GridSeanceExercices" Grid.Row="0" Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Exercice" Binding="{Binding exercice_nom}" Width="180" />
                                <DataGridTextColumn Header="Muscle" Binding="{Binding muscle_cible}" Width="110" />
                                <DataGridTextColumn Header="Séries" Binding="{Binding series}" Width="60" />
                                <DataGridTextColumn Header="Répétitions" Binding="{Binding repetitions}" Width="90" />
                                <DataGridTextColumn Header="Récup (s)" Binding="{Binding recuperation_s}" Width="80" />
                                <DataGridTextColumn Header="Tempo" Binding="{Binding tempo}" Width="90" />
                                <DataGridTextColumn Header="Notes" Binding="{Binding notes}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Padding="12">
                            <StackPanel>
                                <TextBlock x:Name="TxtExerciceFormTitre" Text="Ajouter un exercice à cette séance (sélectionne une ligne du tableau pour la modifier)" FontWeight="Bold" Margin="0,0,0,8" />
