<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suivi Coaching" Height="800" Width="1200" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#2C3E50" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="AlternatingRowBackground" Value="#F5F7FA" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation laterale -->
        <StackPanel Grid.Column="0" Background="#2C3E50">
            <TextBlock Text="Suivi Coaching" Foreground="White" FontSize="20" FontWeight="Bold" Margin="16,20,16,20" />
            <Button x:Name="BtnNavDashboard" Content="Tableau de bord" Style="{StaticResource NavButton}" />
            <Button x:Name="BtnNavClients" Content="Clients" Style="{StaticResource NavButton}" />
            <Button x:Name="BtnNavAdministratif" Content="Administratif" Style="{StaticResource NavButton}" />
            <Button x:Name="BtnNavBibliotheques" Content="Bibliothèques" Style="{StaticResource NavButton}" />
            <Button x:Name="BtnNavProgrammes" Content="Programmes" Style="{StaticResource NavButton}" />
            <Button x:Name="BtnNavNutrition" Content="Nutrition" Style="{StaticResource NavButton}" />
            <Button x:Name="BtnNavSuivi" Content="Suivi" Style="{StaticResource NavButton}" />
            <Button x:Name="BtnNavOutils" Content="Outils" Style="{StaticResource NavButton}" />
        </StackPanel>

        <!-- Zone de contenu -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">

            <!-- ===================== ECRAN TABLEAU DE BORD ===================== -->
            <Grid x:Name="PanelDashboard" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Tableau de bord" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <Button x:Name="BtnDashboardActualiser" Content="Actualiser" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Background="#2C3E50" CornerRadius="6" Padding="20,14" Margin="0,0,12,0" MinWidth="180">
                        <StackPanel>
                            <TextBlock Text="Clients actifs" Foreground="#BBD1E5" FontSize="13" />
                            <TextBlock x:Name="TxtStatClientsActifs" Text="0" Foreground="White" FontSize="30" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#E67E22" CornerRadius="6" Padding="20,14" Margin="0,0,12,0" MinWidth="220">
                        <StackPanel>
                            <TextBlock Text="Paiements en attente" Foreground="#FDEBD0" FontSize="13" />
                            <TextBlock x:Name="TxtStatEnAttente" Text="0 (0 €)" Foreground="White" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#C0392B" CornerRadius="6" Padding="20,14" MinWidth="220">
                        <StackPanel>
                            <TextBlock Text="Paiements en retard" Foreground="#F5C6C2" FontSize="13" />
                            <TextBlock x:Name="TxtStatEnRetard" Text="0 (0 €)" Foreground="White" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Prochaines échéances" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                        <DataGrid x:Name="GridDashboardEcheances">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Client" Binding="{Binding client_nom}" Width="*" />
                                <DataGridTextColumn Header="Échéance" Binding="{Binding date_echeance}" Width="110" />
                                <DataGridTextColumn Header="Montant" Binding="{Binding montant}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Clients sans bilan récent (14 jours et +)" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                        <DataGrid x:Name="GridDashboardSansBilan">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Client" Binding="{Binding client_nom}" Width="*" />
                                <DataGridTextColumn Header="Dernier bilan" Binding="{Binding dernier_bilan}" Width="110" />
                                <DataGridTextColumn Header="Jours écoulés" Binding="{Binding jours_ecoules}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===================== ECRAN CLIENTS ===================== -->
            <Grid x:Name="PanelClients" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Clients" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <CheckBox x:Name="ChkAfficherArchives" Content="Afficher aussi les clients archivés" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="GridClients" Grid.Column="0" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom" Binding="{Binding nom}" Width="120" />
                            <DataGridTextColumn Header="Prénom" Binding="{Binding prenom}" Width="120" />
                            <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="180" />
                            <DataGridTextColumn Header="Téléphone" Binding="{Binding telephone}" Width="120" />
                            <DataGridTextColumn Header="Début coaching" Binding="{Binding date_debut_coaching}" Width="120" />
                            <DataGridTextColumn Header="Statut" Binding="{Binding statut}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Fiche client" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                        <Label Content="Nom *" />
                        <TextBox x:Name="TxtClientNom" />
                        <Label Content="Prénom *" />
                        <TextBox x:Name="TxtClientPrenom" />
                        <Label Content="Email" />
                        <TextBox x:Name="TxtClientEmail" />
                        <Label Content="Téléphone" />
                        <TextBox x:Name="TxtClientTelephone" />
                        <Label Content="Date de début de coaching" />
                        <DatePicker x:Name="DateClientDebut" />
                        <Label Content="Objectifs" />
                        <TextBox x:Name="TxtClientObjectifs" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        <Label Content="Notes libres" />
                        <TextBox x:Name="TxtClientNotes" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="BtnClientNouveau" Content="Nouveau" />
                            <Button x:Name="BtnClientEnregistrer" Content="Enregistrer" Background="#27AE60" Foreground="White" />
                        </StackPanel>
                        <Button x:Name="BtnClientArchiver" Content="Archiver ce client" Margin="0,8,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===================== ECRAN ADMINISTRATIF ===================== -->
            <Grid x:Name="PanelAdministratif" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Administratif" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

                <TabControl x:Name="TabAdministratif" Grid.Row="1">
                    <!-- Devis -->
                    <TabItem Header="Devis">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Label Content="Filtrer :" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox x:Name="CmbDevisFiltre" Width="160">
                                    <ComboBoxItem Content="Tous" IsSelected="True" />
                                    <ComboBoxItem Content="En attente" />
                                    <ComboBoxItem Content="Accepté" />
                                    <ComboBoxItem Content="Refusé" />
                                </ComboBox>
                            </StackPanel>

                            <DataGrid x:Name="GridDevis" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Client" Binding="{Binding client_nom}" Width="160" />
                                    <DataGridTextColumn Header="Prestations" Binding="{Binding prestations}" Width="*" />
                                    <DataGridTextColumn Header="Montant" Binding="{Binding montant}" Width="90" />
                                    <DataGridTextColumn Header="Statut" Binding="{Binding statut}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
                                <TextBlock Text="Nouveau devis" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                                <Label Content="Client *" />
                                <ComboBox x:Name="CmbDevisClient" DisplayMemberPath="affichage" />
                                <Label Content="Prestations *" />
                                <TextBox x:Name="TxtDevisPrestations" Height="50" TextWrapping="Wrap" AcceptsReturn="True" />
                                <Label Content="Montant (€) *" />
                                <TextBox x:Name="TxtDevisMontant" />
                                <Label Content="Durée" />
                                <TextBox x:Name="TxtDevisDuree" />
                                <Button x:Name="BtnDevisCreer" Content="Créer le devis" Background="#27AE60" Foreground="White" Margin="0,12,0,4" HorizontalAlignment="Left" />

                                <TextBlock Text="Devis sélectionné" FontSize="16" FontWeight="Bold" Margin="0,20,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnDevisAccepter" Content="Accepté" Background="#27AE60" Foreground="White" />
                                    <Button x:Name="BtnDevisRefuser" Content="Refusé" Background="#C0392B" Foreground="White" />
                                </StackPanel>
                                <Button x:Name="BtnDevisTransformer" Content="Transformer en commande" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                <TextBlock Text="Un devis transformé en commande disparaît automatiquement de cette liste (il reste visible dans Commandes)." FontStyle="Italic" TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Commandes -->
                    <TabItem Header="Commandes">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Label Content="Filtrer :" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox x:Name="CmbCommandeFiltre" Width="160">
                                    <ComboBoxItem Content="Toutes" IsSelected="True" />
                                    <ComboBoxItem Content="Active" />
                                    <ComboBoxItem Content="Terminée" />
                                    <ComboBoxItem Content="Annulée" />
                                </ComboBox>
                            </StackPanel>

                            <DataGrid x:Name="GridCommandes" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Client" Binding="{Binding client_nom}" Width="140" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding type_facturation}" Width="110" />
                                    <DataGridTextColumn Header="Début" Binding="{Binding date_debut}" Width="90" />
                                    <DataGridTextColumn Header="Fin" Binding="{Binding date_fin}" Width="90" />
                                    <DataGridTextColumn Header="Montant" Binding="{Binding montant}" Width="90" />
                                    <DataGridTextColumn Header="Statut" Binding="{Binding statut}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
                                <TextBlock Text="Nouvelle commande" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                                <Label Content="Client *" />
                                <ComboBox x:Name="CmbCommandeClient" DisplayMemberPath="affichage" />
                                <Label Content="Type de facturation *" />
                                <ComboBox x:Name="CmbCommandeType">
                                    <ComboBoxItem Content="mensuel" />
                                    <ComboBoxItem Content="hebdomadaire" />
                                    <ComboBoxItem Content="one_shot" />
                                </ComboBox>
                                <Label Content="Date de début *" />
                                <DatePicker x:Name="DateCommandeDebut" />
                                <Label Content="Date de fin (sauf one-shot)" />
                                <DatePicker x:Name="DateCommandeFin" />
                                <Label Content="Montant total (€) *" />
                                <TextBox x:Name="TxtCommandeMontant" />
                                <Button x:Name="BtnCommandeCreer" Content="Créer la commande" Background="#27AE60" Foreground="White" Margin="0,12,0,4" HorizontalAlignment="Left" />
                                <TextBlock Text="L'échéancier est généré automatiquement." FontStyle="Italic" TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0" />

                                <TextBlock Text="Commande sélectionnée" FontSize="16" FontWeight="Bold" Margin="0,20,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnCommandeTerminer" Content="Terminée" Background="#27AE60" Foreground="White" />
                                    <Button x:Name="BtnCommandeAnnuler" Content="Annulée" Background="#C0392B" Foreground="White" />
                                    <Button x:Name="BtnCommandeReactiver" Content="Réactiver" />
                                </StackPanel>
                                <TextBlock Text="Une commande passe automatiquement à 'Terminée' quand toutes ses échéances sont payées." FontStyle="Italic" TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Echeances -->
                    <TabItem Header="Paiements / Échéances">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Label Content="Filtrer :" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox x:Name="CmbEcheanceFiltre" Width="160">
                                    <ComboBoxItem Content="Toutes" IsSelected="True" />
                                    <ComboBoxItem Content="En attente" />
                                    <ComboBoxItem Content="En retard" />
                                    <ComboBoxItem Content="Payées" />
                                </ComboBox>
                                <Button x:Name="BtnEcheanceMarquerPayee" Content="Marquer payée" Margin="20,0,0,0" Background="#27AE60" Foreground="White" />
                            </StackPanel>
                            <DataGrid x:Name="GridEcheances" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Client" Binding="{Binding client_nom}" Width="160" />
                                    <DataGridTextColumn Header="Échéance" Binding="{Binding date_echeance}" Width="110" />
                                    <DataGridTextColumn Header="Montant" Binding="{Binding montant}" Width="90" />
                                    <DataGridTextColumn Header="Statut" Binding="{Binding statut}" Width="110" />
                                    <DataGridTextColumn Header="Payée le" Binding="{Binding date_paiement}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ===================== ECRAN BIBLIOTHEQUES ===================== -->
            <Grid x:Name="PanelBibliotheques" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Bibliothèques" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

                <TabControl Grid.Row="1">
                    <!-- Exercices -->
                    <TabItem Header="Exercices">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="TxtExerciceRecherche" Width="300" />
                                <Button x:Name="BtnExerciceRechercher" Content="Rechercher" />
                                <Button x:Name="BtnExerciceExporter" Content="Exporter en Excel" />
                            </StackPanel>
                            <DataGrid x:Name="GridExercices" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nom" Binding="{Binding nom}" Width="220" />
                                    <DataGridTextColumn Header="Muscle ciblé" Binding="{Binding muscle_cible}" Width="150" />
                                    <DataGridTextColumn Header="Variante" Binding="{Binding variante}" Width="120" />
                                    <DataGridTextColumn Header="Lien vidéo" Binding="{Binding lien_video}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
                                <TextBlock Text="Exercice" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                                <Label Content="Nom *" />
                                <TextBox x:Name="TxtExerciceNom" />
                                <Label Content="Muscle ciblé" />
                                <TextBox x:Name="TxtExerciceMuscle" />
                                <Label Content="Variante" />
                                <TextBox x:Name="TxtExerciceVariante" />
                                <Label Content="Lien vidéo" />
                                <TextBox x:Name="TxtExerciceLien" />
                                <Label Content="Image du mouvement" />
                                <Border BorderBrush="#DDD" BorderThickness="1" Height="120" Background="#F5F7FA" Margin="0,0,0,4">
                                    <Image x:Name="ImgExerciceApercu" Stretch="Uniform" Margin="4" />
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnExerciceImageChoisir" Content="Choisir une image..." />
                                    <Button x:Name="BtnExerciceImageRetirer" Content="Retirer l'image" Background="#C0392B" Foreground="White" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="BtnExerciceNouveau" Content="Nouveau" />
                                    <Button x:Name="BtnExerciceEnregistrer" Content="Enregistrer" Background="#27AE60" Foreground="White" />
                                </StackPanel>
                                <Button x:Name="BtnExerciceSupprimer" Content="Supprimer" Background="#C0392B" Foreground="White" Margin="0,8,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Aliments -->
                    <TabItem Header="Aliments">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="TxtAlimentRecherche" Width="300" />
                                <Button x:Name="BtnAlimentRechercher" Content="Rechercher" />
                                <Button x:Name="BtnAlimentExporter" Content="Exporter en Excel" />
                            </StackPanel>
                            <DataGrid x:Name="GridAliments" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nom" Binding="{Binding nom}" Width="200" />
                                    <DataGridTextColumn Header="Qté réf." Binding="{Binding quantite_reference}" Width="70" />
                                    <DataGridTextColumn Header="Unité" Binding="{Binding unite}" Width="55" />
                                    <DataGridTextColumn Header="Kcal" Binding="{Binding kcal}" Width="60" />
                                    <DataGridTextColumn Header="Protéines" Binding="{Binding proteines}" Width="75" />
                                    <DataGridTextColumn Header="Glucides" Binding="{Binding glucides}" Width="75" />
                                    <DataGridTextColumn Header="Lipides" Binding="{Binding lipides}" Width="70" />
                                    <DataGridTextColumn Header="Fibres" Binding="{Binding fibres}" Width="65" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
                                <TextBlock Text="Aliment" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                                <Label Content="Nom *" />
                                <TextBox x:Name="TxtAlimentNom" />
                                <Label Content="Quantité de référence" />
                                <TextBox x:Name="TxtAlimentQuantite" Text="100" />
                                <Label Content="Unité" />
                                <TextBox x:Name="TxtAlimentUnite" Text="g" />
                                <Label Content="Kcal" />
                                <TextBox x:Name="TxtAlimentKcal" />
                                <Label Content="Protéines (g)" />
                                <TextBox x:Name="TxtAlimentProteines" />
                                <Label Content="Glucides (g)" />
                                <TextBox x:Name="TxtAlimentGlucides" />
                                <Label Content="Lipides (g)" />
                                <TextBox x:Name="TxtAlimentLipides" />
                                <Label Content="Fibres (g)" />
                                <TextBox x:Name="TxtAlimentFibres" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="BtnAlimentNouveau" Content="Nouveau" />
                                    <Button x:Name="BtnAlimentEnregistrer" Content="Enregistrer" Background="#27AE60" Foreground="White" />
                                </StackPanel>
                                <Button x:Name="BtnAlimentSupprimer" Content="Supprimer" Background="#C0392B" Foreground="White" Margin="0,8,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Complements -->
                    <TabItem Header="Compléments">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="TxtComplementRecherche" Width="300" />
                                <Button x:Name="BtnComplementRechercher" Content="Rechercher" />
                                <Button x:Name="BtnComplementExporter" Content="Exporter en Excel" />
                            </StackPanel>
                            <DataGrid x:Name="GridComplements" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nom" Binding="{Binding nom}" Width="180" />
                                    <DataGridTextColumn Header="Dose" Binding="{Binding dose}" Width="140" />
                                    <DataGridTextColumn Header="Timing" Binding="{Binding timing}" Width="140" />
