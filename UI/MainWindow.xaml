                    <Button x:Name="BtnProgrammeSupprimer" Content="Supprimer" Background="#C0392B" Foreground="White" />
                    <Button x:Name="BtnProgrammeExporterPdf" Content="Exporter en PDF" Background="#27AE60" Foreground="White" Margin="20,0,8,0" />
                    <Button x:Name="BtnProgrammeExporterExcel" Content="Exporter en Excel" />
