                                    <DataGridTextColumn Header="dont sat. (g)" Binding="{Binding lipides_satures}" Width="90" />
                                    <DataGridTextColumn Header="Glucides (g)" Binding="{Binding glucides}" Width="90" />
                                    <DataGridTextColumn Header="Fibres (g)" Binding="{Binding fibres}" Width="80" />
                                    <DataGridTextColumn Header="Sucres (g)" Binding="{Binding sucres}" Width="80" />
                                    <DataGridTextColumn Header="Protéines (g)" Binding="{Binding proteines}" Width="90" />
                                    <DataGridTextColumn Header="Sodium (mg)" Binding="{Binding sodium_mg}" Width="90" />
                                    <DataGridTextColumn Header="Cholestérol (mg)" Binding="{Binding cholesterol_mg}" Width="110" />
                                    <DataGridTextColumn Header="Potassium (mg)" Binding="{Binding potassium_mg}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ===================== ECRAN OUTILS ===================== -->
            <Grid x:Name="PanelOutils" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Outils" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" />

                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Importer les bibliothèques depuis un fichier Excel" FontSize="16" FontWeight="Bold" />
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,12">
                                Sélectionne ton fichier "SUIVI 2.0.xlsx" (ou un fichier structuré de la même façon) pour
                                importer automatiquement les exercices, aliments et compléments déjà répertoriés dedans.
                                Les éléments déjà présents dans l'application ne sont pas dupliqués.
                            </TextBlock>
                            <Button x:Name="BtnImporterBibliotheques" Content="Choisir le fichier Excel..." HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Sauvegarde de la base de données" FontSize="16" FontWeight="Bold" />
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,12">
                                Crée une copie de sauvegarde horodatée de toutes les données de l'application.
                            </TextBlock>
                            <Button x:Name="BtnSauvegarder" Content="Sauvegarder maintenant" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TxtVersionInstallee" Text="Version installée : —" Foreground="Gray" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
