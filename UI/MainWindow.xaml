                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="ChkQuestionnaireNonRattachees" Content="Afficher les réponses non rattachées (tous clients)" VerticalAlignment="Center" />
