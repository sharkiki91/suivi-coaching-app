                <TextBlock Grid.Row="0" Text="Suivi client" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                    <Label Content="Client :" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbSuiviClient" Width="220" DisplayMemberPath="affichage" Margin="4,0,0,0" />
                </StackPanel>

                <TabControl Grid.Row="2">
                    <!-- Questionnaires -->
                    <TabItem Header="Questionnaires">
